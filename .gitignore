# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Template images — served from Cloudflare R2, not git
public/templates/**/*.png
public/templates/**/*.jpg
public/templates/**/*.jpeg
public/templates/**/*.ai

# typescript
*.tsbuildinfo
next-env.d.ts

# Media / download files in repo root
*.webm
*.mp4
*.mp4.part
*.zip

# Local cache for thumbnail->webp conversion (skip-if-unchanged tracking)
.thumb-webp-cache.json
.full-webp-cache.json

# Scratch preview renders from add-template.mjs's pipeline
.scratch-previews/

# template pipeline working dirs
_originals/
_staging/
